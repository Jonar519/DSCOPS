# Generated by DSCOPS. Do not edit by hand.
# Regenerate with: dscops build <file>.dscops --target terraform

terraform {
  required_version = ">= 1.5"
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
  }
}

provider "docker" {}

{% for variable in secret_variables %}
variable "{{ variable.name }}" {
  type      = string
  sensitive = true
}

{% endfor %}
resource "docker_network" "dscops" {
  name = "dscops"
}

{% for service in services %}
resource "docker_image" "service_{{ service.key }}" {
  name = {{ service.image | tojson }}
}

resource "docker_container" "service_{{ service.key }}" {
  count    = {{ service.replicas }}
  name     = "{{ service.name }}-${count.index}"
  image    = docker_image.service_{{ service.key }}.image_id
  restart  = "unless-stopped"
  must_run = true
{% if service.env %}
  env = [
{% for item in service.env %}
    {{ item }},
{% endfor %}
  ]
{% endif %}
{% if service.command %}
  command    = [{% for item in service.command %}{{ item }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if service.memory_mb %}
  memory     = {{ service.memory_mb }}
{% endif %}
{% if service.depends_on %}
  depends_on = [{% for dependency in service.depends_on %}{{ dependency }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
  networks_advanced {
    name = docker_network.dscops.name
  }
{% if service.public and service.port %}
  ports {
    internal = {{ service.port }}
    external = {{ service.port }} + count.index
  }
{% endif %}
}

{% endfor %}
{% for database in databases %}
resource "docker_image" "database_{{ database.key }}" {
  name = {{ database.image | tojson }}
}

resource "docker_volume" "database_{{ database.key }}" {
  name = "dscops_{{ database.name }}_data"
}

resource "docker_container" "database_{{ database.key }}" {
  count    = 1
  name     = "{{ database.name }}"
  image    = docker_image.database_{{ database.key }}.image_id
  restart  = "unless-stopped"
  must_run = true
{% if database.env %}
  env = [
{% for item in database.env %}
    {{ item }},
{% endfor %}
  ]
{% endif %}
{% if database.command %}
  command = [{% for item in database.command %}{{ item }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
  volumes {
    volume_name    = docker_volume.database_{{ database.key }}.name
    container_path = {{ database.data_path | tojson }}
  }
  networks_advanced {
    name = docker_network.dscops.name
  }
{% if database.public %}
  ports {
    internal = {{ database.port }}
    external = {{ database.port }}
  }
{% endif %}
}

{% endfor %}
