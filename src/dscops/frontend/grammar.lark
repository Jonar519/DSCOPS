// DSCOPS grammar (LALR-friendly subset).
//
// The language is intentionally tiny: resources are declared as blocks with
// `name: value` properties, and links are written as `source -> target`.
// Comments start with `#` and run to the end of the line.

start: statement*

?statement: service
          | database
          | link

service: "service" NAME "{" property* "}"
database: "database" NAME "{" property* "}"
link: NAME "->" NAME

property: NAME ":" value
?value: STRING      -> string
      | NUMBER      -> number
      | BOOL        -> bool
      | call
      | object
      | NAME        -> name

call: NAME "(" [value ("," value)*] ")"
object: "{" [pair ("," pair)*] "}"
pair: NAME ":" value

BOOL.3: "true" | "false"
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"[^"\n]*"/
NUMBER: /[0-9]+/
COMMENT: /#[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
